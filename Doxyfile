# Doxyfile for eventengine-cpp

PROJECT_NAME           = "EventEngine"
PROJECT_NUMBER         = 0.1.0
PROJECT_BRIEF          = "Cross-platform C++17 event-driven library built on libuv"
OUTPUT_DIRECTORY       = docs/api
CREATE_SUBDIRS         = NO

# Input
INPUT                  = include/eventengine
FILE_PATTERNS          = *.hpp *.hpp.in
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */third_party/*

# Extraction
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL  = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO

# Source browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES

# Build
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
PREDEFINED             = EVENTENGINE_API= \
                         EVENTENGINE_BUILDING_SHARED \
                         DOXYGEN_SHOULD_SKIP_THIS

# Suppress warnings for macros used purely as annotations
WARN_IF_UNDOC_ENUM_VAL = NO

# Output formats
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = LIGHT
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO

# Diagrams
HAVE_DOT               = NO
CLASS_GRAPH            = YES

# Warnings
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
